#!/usr/bin/env node
/**
 * Zero CLI - Bleeding-Edge Agentic Intelligence System
 *
 * A lightweight, security-hardened CLI that leverages:
 * - Knowledge Graph for intelligent suggestions
 * - Session Store for time-travel (undo/redo)
 * - Signal Protocol for multi-model consensus
 * - Fact-verification to prevent hallucinations
 * - Multi-agent orchestration via tmux
 *
 * Zero external dependencies for core CLI.
 *
 * @author Tej Desai <admin@terminals.tech>
 * @license MIT
 */

'use strict';

const path = require('path');

// Ensure we're in the right context
process.title = 'zero';

// Handle uncaught errors gracefully
process.on('uncaughtException', (err) => {
  process.stderr.write(`\x1b[31mFatal error: ${err.message}\x1b[0m\n`);
  if (process.env.DEBUG) {
    process.stderr.write(err.stack + '\n');
  }
  process.exit(1);
});

process.on('unhandledRejection', (reason) => {
  process.stderr.write(`\x1b[31mUnhandled rejection: ${reason}\x1b[0m\n`);
  process.exit(1);
});

/**
 * Determine which mode to run in and execute
 */
async function main() {
  const args = process.argv.slice(2);

  // Check if orchestrator mode (args contain known agent IDs)
  let orchestrator;
  try {
    orchestrator = require('../src/cli/orchestrator/index.js');
  } catch (err) {
    // Orchestrator module not available, use standard CLI
    orchestrator = null;
  }

  // Route to orchestrator if:
  // 1. Orchestrator module is available
  // 2. Args contain known agent IDs or --orchestrate flag
  if (orchestrator && orchestrator.isOrchestratorMode(args)) {
    await orchestrator.run(args);
    return;
  }

  // Standard CLI mode
  const cli = require('../src/cli/index.js');
  await cli.run(args);
}

// Graceful shutdown state
let isShuttingDown = false;

// Graceful shutdown helper with PGlite WASM cleanup
async function gracefulShutdown(exitCode = 0) {
  // Prevent multiple shutdown attempts
  if (isShuttingDown) return;
  isShuttingDown = true;

  // Final emergency timeout - if we haven't exited in 5s, force it
  const emergencyTimer = setTimeout(() => {
    process.stderr.write(`\x1b[31mEmergency shutdown triggered\x1b[0m\n`);
    process.exit(exitCode);
  }, 5000);
  emergencyTimer.unref();

  try {
    // 1. Stop background workers first to prevent new DB operations
    try {
      const mcpServer = require('../src/server/mcpServer');
      if (mcpServer && mcpServer.stopJobWorker) {
        mcpServer.stopJobWorker();
      }
    } catch (_) { /* ignore if not loaded */ }

    // 2. Close database gracefully to prevent mutex lock errors
    const dbClient = require('../src/utils/dbClient');
    if (dbClient && dbClient.close) {
      const closePromise = dbClient.close();
      const timeoutPromise = new Promise((_, reject) => 
        setTimeout(() => reject(new Error('DB close timeout')), 2500)
      );
      await Promise.race([closePromise, timeoutPromise]).catch((e) => {
        if (process.env.DEBUG) process.stderr.write(`Shutdown race: ${e.message}\n`);
      });
    }
  } catch (err) {
    // Ignore errors during cleanup
  }
  
  // Final safeguard: allow event loop to drain
  clearTimeout(emergencyTimer);
  setTimeout(() => {
    process.exit(exitCode);
  }, 500).unref();
}

// Handle termination signals
process.on('SIGINT', () => gracefulShutdown(0));
process.on('SIGTERM', () => gracefulShutdown(0));

// Run
main().then(async () => {
  // Close database gracefully before exit
  await gracefulShutdown(0);
}).catch(async (err) => {
  process.stderr.write(`\x1b[31mError: ${err.message}\x1b[0m\n`);
  await gracefulShutdown(1);
});
