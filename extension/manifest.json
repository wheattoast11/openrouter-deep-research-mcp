{
  "manifest_version": 3,
  "name": "Zero - Self-Referential MCP Agent",
  "version": "1.10.0",
  "description": "Zero: The fixed point of client-server duality. Self-referential MCP agent for multi-agent AI research.",
  "author": "Tej Desai <admin@terminals.tech>",
  "homepage_url": "https://terminals.tech",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "optional_permissions": [
    "tabs",
    "history",
    "bookmarks"
  ],

  "host_permissions": [
    "https://*.terminals.tech/*",
    "https://*.openrouter.ai/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Zero Agent",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["<all_urls>"]
    }
  ],

  "externally_connectable": {
    "matches": ["https://*.terminals.tech/*"]
  },

  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Open Zero Agent"
    },
    "toggle-zero": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Toggle Zero overlay"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
