{
  "$schema": "https://schema.modelcontextprotocol.io/servers.json",
  "mcpServers": {
    "openrouter-agents": {
      "command": "node",
      "args": [
        "/var/home/zero/terminals-tech/src/server/mcpServer.js",
        "--stdio"
      ],
      "env": {
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",

        "_comment_mode": "ALL mode exposes all tools. Use AGENT for single-tool routing, MANUAL for discrete tools",
        "MODE": "ALL",

        "_comment_core_features": "Essential features for async research and knowledge base",
        "INDEXER_ENABLED": "true",
        "MCP_ENABLE_TASKS": "true",
        "MCP_SAMPLING_TOOLS": "true",

        "_comment_performance": "Performance optimizations",
        "EMBEDDING_BATCH_SIZE": "10",
        "EMBEDDING_CACHE_SIZE": "1000",
        "JOB_TTL_HOURS": "1",

        "_comment_logging": "Structured logging for production (stderr for STDIO, JSON for aggregation)",
        "LOG_LEVEL": "info",
        "LOG_OUTPUT": "stderr",
        "LOG_JSON": "false",

        "_comment_protocol": "MCP 2025-11-25 draft features",
        "MCP_ELICITATION_URL": "true",
        "MCP_APPS_ENABLED": "false",

        "_comment_experimental": "Zero Protocol features (opt-in)",
        "CORE_HANDLERS_ENABLED": "false",
        "SIGNAL_PROTOCOL_ENABLED": "false",
        "ROLESHIFT_ENABLED": "false",
        "STRICT_SCHEMA_VALIDATION": "false",

        "_comment_models": "Cost tiers for research quality/cost tradeoff",
        "HIGH_COST_MODELS": "openai/gpt-5.2,anthropic/claude-sonnet-4.5,anthropic/claude-opus-4.5,google/gemini-3-pro-preview",
        "LOW_COST_MODELS": "deepseek/deepseek-chat-v3.2,anthropic/claude-haiku-4.5,google/gemini-3-flash-preview,z-ai/glm-4.7",
        "PLANNING_MODEL": "google/gemini-3-flash-preview"
      },

      "_comment_resources": "Expose selective resources for agentic workflows",
      "resources": {
        "_comment_knowledge_base": "Most token-efficient - search before researching",
        "enabled": [
          "knowledge-base://reports",
          "knowledge-base://search"
        ],

        "_comment_ui_resources": "MCP Apps for interactive UI (if MCP_APPS_ENABLED=true)",
        "optional": [
          "ui://research/viewer",
          "ui://knowledge/graph",
          "ui://timeline/session"
        ]
      },

      "_comment_tool_patterns": "Workflow-optimized tool priorities",
      "toolPriorities": {
        "_comment_high_priority": "Always-available health check and async status",
        "high": ["ping", "get_server_status", "job_status", "get_job_status"],

        "_comment_medium_priority": "Research and knowledge base (core workflows)",
        "medium": ["research", "batch_research", "search", "retrieve", "get_report", "history"],

        "_comment_low_priority": "Advanced features and utilities",
        "low": ["query", "sample_message", "graph_traverse", "time_travel", "undo", "redo"]
      },

      "_comment_agentic_workflows": "Documented patterns from TOOL-PATTERNS.md",
      "workflows": {
        "async_research": {
          "description": "Background research with job monitoring",
          "pattern": "research(async:true) -> job_status(poll) -> get_report(reportId)",
          "token_cost": "low",
          "recommended_for": "queries >30s, parallel research"
        },
        "search_before_research": {
          "description": "Check knowledge base before creating new research",
          "pattern": "search(q) -> if_not_found(conduct_research)",
          "token_cost": "minimal",
          "recommended_for": "all research tasks"
        },
        "batch_parallel": {
          "description": "Dispatch multiple research queries efficiently",
          "pattern": "batch_research(queries, waitForCompletion:true)",
          "token_cost": "medium",
          "recommended_for": "2-10 parallel queries"
        },
        "session_timetravel": {
          "description": "Undo/redo and fork alternate timelines",
          "pattern": "undo() | redo() | fork_session(newId) | time_travel(timestamp)",
          "token_cost": "negligible",
          "recommended_for": "exploratory analysis, what-if scenarios"
        }
      }
    }
  },

  "_documentation": {
    "overview": "Optimized MCP config for OpenRouter Agents server v1.10.0+",
    "goals": [
      "Token efficiency: selective resources, search-before-research pattern",
      "High performance: async jobs, batch research, embedding cache",
      "Agentic flows: documented workflows cover key user journeys",
      "Minimal abstraction: direct tool access, flexible parameter normalization"
    ],
    "key_patterns": {
      "parameter_aliases": "q→query, cost→costPreference, id→reportId (auto-normalized)",
      "mode_detection": "SQL vs index auto-detected in retrieve tool",
      "error_recovery": "See docs/TOOL-PATTERNS.md for gotchas and solutions"
    },
    "references": [
      "CLAUDE.md - Complete LLM integration guide",
      "docs/TOOL-PATTERNS.md - Gotchas and recovery patterns",
      "docs/RFP-USER-JOURNEY.md - Example end-to-end workflow"
    ]
  }
}
