SUPABASE_URL=https://terminals-tech.supabase.co
TERMINALS_BASE_URL=https://terminals.tech
ZERO_OAUTH_PROVIDER=terminals
ZERO_OAUTH_CLIENT_ID=zero-cli
PGLITE_FORCE_FILE=true
OPENROUTER_API_KEY=sk-or-v1-yourkeyhere

# === Web Search APIs (Optional - improves web grounding) ===
# At least one is recommended for reliable web grounding
# Free tiers available for all:

# Brave Search API - 2000 queries/month free
# Get key: https://brave.com/search/api/
BRAVE_API_KEY=

# Tavily Search API - 1000 searches/month free
# Get key: https://tavily.com/
TAVILY_API_KEY=

# Serper.dev API - 2500 queries/month free
# Get key: https://serper.dev/
SERPER_API_KEY=

# Bing Web Search API (Azure) - 1000 transactions/month free
# Get key: https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=

# Google Custom Search API - 100 queries/day free
# Get key: https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Custom SearxNG instance (optional, public instances used as fallback)
SEARXNG_URL=

# === Timeout Configuration (Optional) ===
# Chat completion timeout in milliseconds (default: 120000 = 2 min)
CHAT_TIMEOUT_MS=120000

# Stream completion timeout in milliseconds (default: 300000 = 5 min)
STREAM_TIMEOUT_MS=300000

# === Web Grounding Configuration ===
# Enable/disable web grounding (default: true)
WEB_GROUNDING_ENABLED=true

# Max web search results to include (default: 5)
WEB_GROUNDING_MAX_RESULTS=5
